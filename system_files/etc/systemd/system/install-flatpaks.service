[Unit]
Description=Install user-curated Flatpaks
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/.install-flatpaks

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak install --system -y flathub \
be.alexandervanhee.gradia \
com.github.PintaProject.Pinta \
com.github.tchx84.Flatseal \
com.mattjakeman.ExtensionManager \
com.vscodium.codium \
io.github.flattool.Warehouse \
io.github.kolunmi.Bazaar \
io.gitlab.adhami3310.Impression \
io.missioncenter.MissionCenter \
org.gnome.baobab \
org.gnome.Calculator \
org.gnome.Calendar \
org.gnome.Contacts \
org.gnome.Decibels \
org.gnome.FileRoller \
org.gnome.Firmware \
org.gnome.Logs \
org.gnome.Loupe \
org.gnome.NautilusPreviewer \
org.gnome.Showtime \
org.gnome.Snapshot \
org.gnome.TextEditor \
org.gnome.Weather \
org.gtk.Gtk3theme.adw-gtk3 \
org.gtk.Gtk3theme.adw-gtk3-dark \
org.mozilla.firefox \
page.tesk.Refine

ExecStart=/usr/bin/flatpak install --system -y --from https://github.com/gxanshu/postcard/releases/latest/download/postcard.flatpakref

ExecStartPost=/usr/bin/touch /var/lib/.install-flatpaks

[Install]
WantedBy=multi-user.target
