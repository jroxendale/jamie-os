[Unit]
Description=Initialise and apply Chezmoi dotfiles
After=network-online.target
Wants=network-online.target
ConditionPathExists=!%h/.local/share/chezmoi

[Service]
Type=oneshot
ExecStart=/usr/bin/chezmoi init --apply https://github.com/jroxendale/dotfiles.git

[Install]
WantedBy=default.target
